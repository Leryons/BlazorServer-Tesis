@page "/Register"
@rendermode InteractiveServer

<PageTitle>Crear Cuenta</PageTitle>

<div class="form-card entry-animation">
    <h3>Crear Cuenta</h3>

    <div class="row">
        <div class="field">
            <label>Nombre Completo</label>
            <input class="form-control" type="text" @bind-value="newUser.Name" @bind-value:event="oninput" placeholder="Ej. Juan Pérez" />
        </div>
        
        <div class="field">
            <label>Rol de Usuario</label>
            <select class="form-control" @bind="newUser.Role">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
    </div>

    <div class="row">
        <div class="field">
            <label>Correo Electrónico</label>
            <input class="form-control" type="email" @bind-value="newUser.Email" @bind-value:event="oninput" placeholder="correo@ejemplo.com" />
        </div>
    </div>

    <div class="row">
        <div class="field">
            <label>Contraseña</label>
            <input class="form-control" type="password" @bind-value="newUser.Password" @bind-value:event="oninput" placeholder="••••••••" />
        </div>

        <div class="field">
            <label>Confirmar</label>
            <input class="form-control" type="password" @bind-value="ConfirmPassword" @bind-value:event="oninput" placeholder="••••••••" />
        </div>
    </div>

    <button class="btn-submit" 
        disabled="@(!IsFormValid() || waitingForSensor || registroEnProceso)" 
        @onclick="RegisterUser">
        Registrarse ahora
    </button>

    @if (waitingForSensor || registroEnProceso)
    {
        <div class="full-screen-spinner">
            <div class="spinner">Procesando registro...</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <p class="status-msg">@statusMessage</p>
    }
</div>